# App
APP_PACKAGE_NAME=com.fempsychmonitor

# RevenueCat
REVENUECAT_API_KEY=your_revenuecat_api_key_here

# AdMob - Production Ad Unit IDs
ADMOB_BANNER_TOP=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY
ADMOB_BANNER_BOTTOM=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY
ADMOB_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY
ADMOB_REWARDED=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY

# AdMob - App ID (also used in AndroidManifest.xml)
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXX~YYYYYYYYYY

# Google Sign-In OAuth
GOOGLE_SERVER_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Backend cPanel (API PHP + MySQL)
# API_BASE_URL: alamat folder api/ di server, misal https://domain.com/api
API_BASE_URL=https://your-domain.com/api
# API_KEY: WAJIB sama dengan API_KEY di cpanel_api/api/config.php
API_KEY=ganti_dengan_secret_acak_panjang

# Server inferensi SER lokal (ser_server/server_ssl.py)
# Desktop: http://127.0.0.1:8001 | Emulator Android: http://10.0.2.2:8001
# HP fisik: IP LAN laptop, mis. http://192.168.1.5:8001
SER_BASE_URL=http://127.0.0.1:8001

# Admin (akun auto-dibuat saat pertama kali app dijalankan)
ADMIN_EMAIL=admin@fempsychmonitor.com
ADMIN_PASSWORD=Admin123!
