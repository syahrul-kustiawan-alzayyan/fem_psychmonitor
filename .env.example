# App
APP_PACKAGE_NAME=com.fempsychmonitor

# RevenueCat
REVENUECAT_API_KEY=your_revenuecat_api_key_here

# AdMob - Production Ad Unit IDs
ADMOB_BANNER_TOP=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY
ADMOB_BANNER_BOTTOM=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY
ADMOB_INTERSTITIAL=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY
ADMOB_APP_OPEN=ca-app-pub-XXXXXXXXXXXX/YYYYYYYYYY

# AdMob - App ID (also used in AndroidManifest.xml)
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXX~YYYYYYYYYY

# Google Sign-In OAuth
GOOGLE_SERVER_CLIENT_ID=XXXXXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Firebase (informational - loaded from google-services.json)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id
